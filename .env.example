# =============================================================================
# 월드킹 보물찾기 — 환경 변수 (.env.example)
# =============================================================================
# 이 앱이 DB에 붙는 데 필요한 변수는 아래 2개뿐입니다.
# (Supabase JS 클라이언트·anon key·Vercel 전용 "인증키"는 사용하지 않습니다.)
#
# [할 일 요약]
# 1) Supabase 콘솔에서 DATABASE_URL, DIRECT_URL 값을 복사합니다.
# 2) 프로젝트 루트에 `.env` 파일을 만들고(또는 복사: cp .env.example .env)
#    아래 두 줄에 붙여 넣습니다. 비밀번호는 따옴표로 감싸면 특수문자에 안전합니다.
#    주의: URI 전체를 대괄호 [ ... ] 로 감싸면 안 됩니다. (연결 실패·시드 오류 원인)
# 3) Vercel 대시보드 → 해당 프로젝트 → Settings → Environment Variables 에
#    "이름이 완전히 같은" 두 변수를 Production(및 Preview)에도 넣습니다.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE_URL (필수)
# -----------------------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string
# → "Transaction pooler" / URI / 포트 6543
# 끝에 다음이 붙어 있으면 Vercel 서버리스에 잘 맞습니다:
#   ?pgbouncer=true&connection_limit=1
#
# 사용자 이름은 보통 postgres 또는 postgres.<프로젝트ref> 형태입니다. 예:
#   postgresql://postgres.sqcqpspzigmkwckvegwl:비밀번호@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres
# [YOUR-PASSWORD] 는 문서용 표기일 뿐이니, 반드시 Supabase DB 비밀번호로 바꿉니다(대괄호 제거).
# 리전에 따라 aws-0 / aws-1, ap-northeast-1 / 2 등 호스트가 달라질 수 있으며 모두 정상입니다.
# 끝에 Prisma·서버리스 권장 쿼리를 붙이려면:
#   .../postgres?pgbouncer=true&connection_limit=1

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# -----------------------------------------------------------------------------
# DIRECT_URL (필수)
# -----------------------------------------------------------------------------
# 같은 Database 화면에서 "Session mode" / 포트 5432 (pooler 호스트) 권장.
# `db.xxx.supabase.co:5432` 직접 연결은 맥/회사망에서 P1001(접속 불가)이 잘 납니다.
# 그럴 때는 URI를 **Session pooler** 로 두면 됩니다 (Transaction 과 같은 pooler 도메인, 포트만 5432).
# → prisma migrate deploy / db execute 가 이 주소로 붙습니다.
#
# 로컬에서만 빠르게 쓰고 싶으면, 처음에는 DATABASE_URL 과 "직접 연결" URI를
# 동일하게 넣어도 됩니다. (운영 트래픽이 커지면 풀러/직접 분리 권장)
#
# 예시 형식:
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"


# -----------------------------------------------------------------------------
# 추석 미션 — 카운터 직원 확인 PIN (코인 수령)
# -----------------------------------------------------------------------------
# 「네, 받을게요!」 후 직원이 입력. 미설정 시 기본값 1001.
CHUSEOK_STAFF_PIN="1001"
